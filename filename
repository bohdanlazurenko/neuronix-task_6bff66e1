// types/habit.ts
export interface Habit {
  id: string;
  name: string;
  frequency: 'daily' | 'weekly' | 'custom';
  targetCompletionTime?: string;
  reminderEnabled: boolean;
  currentStreak: number;
  longestStreak: number;
  completedDates: Date[];
}

export interface User {
  id: string;
  email: string;
  habits: Habit[];
}